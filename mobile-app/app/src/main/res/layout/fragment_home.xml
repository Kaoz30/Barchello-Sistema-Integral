<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========== BANNER PROMOCIONAL ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            android:clipChildren="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp">

                <!-- Banner (ViewPager2) -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/bannerViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Indicadores de página (dots) superpuestos en la parte inferior -->
                <LinearLayout
                    android:id="@+id/ll_banner_indicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:layout_marginTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="2dp"
                    android:padding="5dp"
                    android:background="@drawable/bg_dot_container" /> <!-- Fondo semitransparente sutil para que los dots se vean sobre imágenes claras -->

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== TARJETA DE CATEGORÍAS (fondo arena) ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/arena">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Título de categorías -->
                <TextView
                    style="@style/TituloPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria"
                    android:textSize="18sp"
                    android:layout_marginBottom="5dp" />

                <!-- RecyclerView de categorías (GRID DE 3 COLUMNAS) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_categorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== TARJETA DE PRODUCTOS DESTACADOS (fondo arena) ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/arena">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Título "Lo más pedido" -->
                <TextView
                    style="@style/TituloPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/productos_destacados"
                    android:textSize="18sp"
                    android:layout_marginBottom="5dp" />

                <!-- RecyclerView horizontal para productos destacados -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_destacados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== BOTÓN VER MENÚ COMPLETO ========== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ver_menu_completo"
            style="@style/ButtonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ver_menu_completo"
            android:padding="14dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/blanco"
            android:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>