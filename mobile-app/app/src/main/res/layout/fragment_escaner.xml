<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C0000000">

    <!-- Marco de escaneo (toca para simular escaneo) -->
    <View
        android:id="@+id/view_escaneo"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_qr_scanner"
        android:clickable="true"
        android:focusable="true"
        tools:ignore="SpeakableTextPresentCheck" />

    <!-- Línea animada del láser -->
    <View
        android:id="@+id/linea_laser"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="32dp"
        android:background="@color/roble"
        android:alpha="0.8" />

    <!-- Panel de botones inferior con TextView compuestos (más limpio) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:baselineAligned="false">

        <!-- Botón: Código -->
        <TextView
            android:id="@+id/btn_codigo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            app:drawableTopCompat="@drawable/ic_barcode"
            android:text="@string/escaner_codigo"
            android:textColor="@color/blanco"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />

        <!-- Botón: Linterna -->
        <TextView
            android:id="@+id/btn_linterna"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            app:drawableTopCompat="@drawable/ic_flash_off"
            android:text="@string/escaner_linterna"
            android:textColor="@color/blanco"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />

        <!-- Botón: Imagen -->
        <TextView
            android:id="@+id/btn_imagen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            app:drawableTopCompat="@drawable/ic_image"
            android:text="@string/escaner_imagen"
            android:textColor="@color/blanco"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Texto de ayuda arriba del marco -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/escaner_ayuda"
        android:textColor="@color/arena"
        android:background="#80000000"
        android:padding="8dp"
        android:layout_above="@id/view_escaneo"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />

</RelativeLayout>