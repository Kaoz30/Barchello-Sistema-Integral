<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="8dp"
    android:clipToOutline="true"
    tools:ignore="UnusedAttribute"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_producto_imagen"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/placeholder_food"
            android:scaleType="centerCrop"
            android:contentDescription="@string/hamburguesa_imagen_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_producto_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/hamburguesa_nombre"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/cuero" />

            <TextView
                android:id="@+id/tv_producto_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="@string/hamburguesa_descripcion"
                android:textColor="@color/gris_claro"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_producto_precio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hamburguesa_precio"
                android:textColor="@color/roble"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_agregar_item"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="@string/mas"
            style="@style/ButtonSecundario"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:gravity="center"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>