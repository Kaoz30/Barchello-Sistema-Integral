<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado presionado (cuando el usuario toca el botón) -->
    <item android:state_pressed="true" android:drawable="@drawable/bg_button_primary_pressed" />
    <!-- Estado deshabilitado (botón inactivo) -->
    <item android:state_enabled="false" android:drawable="@drawable/bg_button_primary_disabled" />
    <!-- Estado normal (por defecto) -->
    <item android:drawable="@drawable/bg_button_primary" />
</selector>