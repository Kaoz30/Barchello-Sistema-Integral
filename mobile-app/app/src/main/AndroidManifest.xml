<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos necesarios -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Declaración de uso de cámara (opcional) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BarchelloCliente">

        <!-- SPLASH ACTIVITY como LAUNCHER (pantalla de inicio) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BarchelloCliente">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LOGIN ACTIVITY (sin intent-filter) -->
        <activity android:name=".activities.LoginActivity" />

        <!-- REGISTRO ACTIVITY -->
        <activity android:name=".activities.RegistroActivity"
            android:exported="true" />

        <!-- MAIN ACTIVITY (home con bottom navigation) -->
        <activity
            android:name=".activities.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- OTRAS ACTIVIDADES -->
        <activity android:name=".activities.MenuActivity" android:exported="true" />
        <activity android:name=".activities.DetalleProductoActivity" android:exported="true" />
        <activity android:name=".activities.SeguimientoPedidoActivity" />
    </application>
</manifest>